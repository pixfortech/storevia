{
  "name": "@storevia/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./system": "./src/system.ts",
    "./platform": "./src/platform.ts",
    "./testing": "./src/testing.ts",
    "./billing": "./src/billing.ts",
    "./worker": "./src/worker.ts",
    "./marketing": "./src/marketing.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.int.config.ts",
    "db:setup": "tsx scripts/setup.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:test:prepare": "tsx scripts/reset.ts --target=test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "vitest": "4.1.11"
  }
}
