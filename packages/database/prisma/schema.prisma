// -----------------------------------------------------------------------------
// 5. Media
// -----------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
  DELETED
}

model MediaAsset {
  id               String      @id @default(uuid(7)) @db.Uuid
  organisationId   String      @db.Uuid
  storeId          String      @db.Uuid
  kind             MediaKind
  status           MediaStatus @default(PENDING_UPLOAD)
  filename         String
  /// MIME detected server-side from content (magic bytes), not the extension.
  mimeType         String?
  declaredMimeType String
  sizeBytes        BigInt?
  width            Int?
  height           Int?
  durationMs       Int?
  /// Opaque key: {organisationId}/{storeId}/{mediaId}/original — never user input.
  storageKey       String      @unique
  sha256           String?
  altText          String?
  /// Generated renditions: [{ key, width, height, format }]
  renditions       Json?
  createdById      String?     @db.Uuid
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?   @db.Timestamptz(3)

  store        Store          @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  productMedia ProductMedia[]

  @@unique([id, storeId])
  @@index([storeId, createdAt])
  @@index([storeId, kind, status])
}

// -----------------------------------------------------------------------------
// 6. Catalogue
// -----------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// SQL: partial unique (storeId, handle) WHERE deletedAt IS NULL;
/// GIN full-text index over title/tags (see search ADR).
model Product {
  id              String        @id @default(uuid(7)) @db.Uuid
  organisationId  String        @db.Uuid
  storeId         String        @db.Uuid
  title           String
  handle          String
  status          ProductStatus @default(DRAFT)
  /// Canonical rich text as Tiptap/ProseMirror JSON; HTML is derived.
  descriptionDoc  Json?
  /// Sanitised HTML rendered from descriptionDoc (cache, never user-authored).
  descriptionHtml String?
  productType     String?
  vendor          String?
  tags            String[]
  /// Reference into the global product taxonomy (deferred, see erd.md §7).
  categoryCode    String?
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?     @db.Timestamptz(3)
  /// Set when the product is archived; cleared when it is restored (ADR-0027).
  archivedAt      DateTime?     @db.Timestamptz(3)
  /// Authorship; kept when the user is deleted (ADR-0027).
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?     @db.Timestamptz(3)

  store       Store               @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  createdBy   User?               @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?               @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  options     ProductOption[]
  variants    ProductVariant[]
  media       ProductMedia[]
  collections CollectionProduct[]

  @@unique([id, storeId])
  @@index([createdById])
  @@index([updatedById])
  @@index([storeId, status, updatedAt])
}

/// e.g. "Size", "Colour". Max 3 options per product (service rule).
model ProductOption {
  id             String @id @default(uuid(7)) @db.Uuid
  organisationId String @db.Uuid
  storeId        String @db.Uuid
  productId      String @db.Uuid
  name           String
  position       Int

  store         Store                       @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  product       Product                     @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  values        ProductOptionValue[]
  variantValues ProductVariantOptionValue[]

  @@unique([productId, name])
  @@unique([productId, position])
  @@unique([id, storeId])
  @@unique([id, productId])
  @@index([storeId])
}

model ProductOptionValue {
  id             String @id @default(uuid(7)) @db.Uuid
  organisationId String @db.Uuid
  storeId        String @db.Uuid
  optionId       String @db.Uuid
  value          String
  position       Int

  store         Store                       @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  option        ProductOption               @relation(fields: [optionId, storeId], references: [id, storeId], onDelete: Cascade)
  variantValues ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@unique([id, storeId])
  @@unique([id, optionId])
  @@index([storeId])
}

enum InventoryPolicy {
  DENY
  CONTINUE
}

/// Every product has >= 1 variant. A product without options has exactly one
/// "default" variant (optionSignature = ""). Prices are store-currency minor
/// units; `currency` is stored explicitly so every amount carries its currency.
/// SQL: partial unique (storeId, sku) WHERE sku IS NOT NULL AND deletedAt IS NULL;
///      CHECK (priceAmount >= 0), CHECK (compareAtAmount IS NULL OR compareAtAmount > priceAmount).
model ProductVariant {
  id               String          @id @default(uuid(7)) @db.Uuid
  organisationId   String          @db.Uuid
  storeId          String          @db.Uuid
  productId        String          @db.Uuid
  title            String
  /// Sorted "optionId=valueId" pairs; unique per product. Prevents duplicates.
  optionSignature  String
  sku              String?
  barcode          String?
  currency         String          @db.Char(3)
  priceAmount      BigInt
  compareAtAmount  BigInt?
  costAmount       BigInt?
  weightGrams      Int?
  requiresShipping Boolean         @default(true)
  taxable          Boolean         @default(true)
  taxCode          String?
  inventoryPolicy  InventoryPolicy @default(DENY)
  imageMediaId     String?         @db.Uuid
  position         Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?       @db.Timestamptz(3)

  store         Store                       @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  product       Product                     @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  optionValues  ProductVariantOptionValue[]
  inventoryItem InventoryItem?

  @@unique([productId, optionSignature])
  @@unique([id, storeId])
  @@index([storeId, sku])
}

/// Exactly one value per option per variant (unique variantId+optionId);
/// the value must belong to that option (composite FK optionValueId+optionId).
model ProductVariantOptionValue {
  organisationId String @db.Uuid
  storeId        String @db.Uuid
  variantId      String @db.Uuid
  optionId       String @db.Uuid
  optionValueId  String @db.Uuid

  store       Store              @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  variant     ProductVariant     @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade)
  option      ProductOption      @relation(fields: [optionId, storeId], references: [id, storeId], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([optionValueId])
  @@index([storeId])
  @@index([optionId])
}

model ProductMedia {
  id             String  @id @default(uuid(7)) @db.Uuid
  organisationId String  @db.Uuid
  storeId        String  @db.Uuid
  productId      String  @db.Uuid
  mediaAssetId   String  @db.Uuid
  position       Int
  altText        String?

  store      Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  product    Product    @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([productId, mediaAssetId])
  @@index([productId, position])
  @@index([storeId])
  @@index([mediaAssetId])
}

enum CollectionType {
  MANUAL
  SMART
}

enum CollectionSortOrder {
  MANUAL
  BEST_SELLING
  TITLE_ASC
  TITLE_DESC
  PRICE_ASC
  PRICE_DESC
  CREATED_DESC
}

/// SQL: partial unique (storeId, handle) WHERE deletedAt IS NULL.
model Collection {
  id              String              @id @default(uuid(7)) @db.Uuid
  organisationId  String              @db.Uuid
  storeId         String              @db.Uuid
  title           String
  handle          String
  type            CollectionType      @default(MANUAL)
  /// SMART collections: validated rule set (schema in packages/validation).
  rules           Json?
  sortOrder       CollectionSortOrder @default(MANUAL)
  descriptionDoc  Json?
  descriptionHtml String?
  imageMediaId    String?             @db.Uuid
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?           @db.Timestamptz(3)
  /// Set when the collection is archived (hidden, restorable); ADR-0027.
  archivedAt      DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?           @db.Timestamptz(3)

  store    Store               @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  products CollectionProduct[]

  @@unique([id, storeId])
  @@index([storeId, updatedAt])
}

model CollectionProduct {
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  collectionId   String   @db.Uuid
  productId      String   @db.Uuid
  position       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  store      Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  collection Collection @relation(fields: [collectionId, storeId], references: [id, storeId], onDelete: Cascade)
  product    Product    @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
  @@index([storeId])
}

// -----------------------------------------------------------------------------
// 7. Inventory (location-aware, movement-audited)
// -----------------------------------------------------------------------------

model Location {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organisationId      String    @db.Uuid
  storeId             String    @db.Uuid
  name                String
  /// Short stable reference ("MAIN", "WH-2"); SQL: partial unique (storeId, code)
  /// WHERE deletedAt IS NULL (ADR-0027).
  code                String
  addressLine1        String?
  addressLine2        String?
  city                String?
  region              String?
  postalCode          String?
  countryCode         String    @db.Char(2)
  phone               String?
  isActive            Boolean   @default(true)
  fulfilsOnlineOrders Boolean   @default(true)
  /// Lower value = preferred when allocating online orders.
  priority            Int       @default(0)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime? @db.Timestamptz(3)

  store     Store               @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  levels    InventoryLevel[]
  movements InventoryMovement[]

  @@unique([id, storeId])
  @@index([storeId])
}

/// 1:1 with ProductVariant. Separated so inventory can later exist for
/// non-variant stock (bundles, components) without touching the catalogue.
model InventoryItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @db.Uuid
  storeId         String   @db.Uuid
  variantId       String   @unique @db.Uuid
  tracked         Boolean  @default(true)
  countryOfOrigin String?  @db.Char(2)
  hsCode          String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  store     Store               @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  variant   ProductVariant      @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade)
  levels    InventoryLevel[]
  movements InventoryMovement[]

  @@unique([id, storeId])
  @@unique([variantId, storeId])
  @@index([storeId])
}

/// on hand = available + reserved. Quantities change ONLY through the
/// inventory service, which writes an InventoryMovement in the same
/// transaction. SQL: CHECK (reserved >= 0 AND incoming >= 0).
model InventoryLevel {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @db.Uuid
  storeId         String   @db.Uuid
  inventoryItemId String   @db.Uuid
  locationId      String   @db.Uuid
  available       Int      @default(0)
  reserved        Int      @default(0)
  incoming        Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  store         Store         @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId, storeId], references: [id, storeId], onDelete: Cascade)
  location      Location      @relation(fields: [locationId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([inventoryItemId, locationId])
  @@index([locationId])
  @@index([storeId])
}

enum InventoryQuantityName {
  AVAILABLE
  RESERVED
  INCOMING
}

enum InventoryMovementReason {
  /// First stock recorded for an item at a location (ADR-0027).
  INITIAL
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  TRANSFER
  RESTOCK
  CANCELLATION
  RESERVATION
  RESERVATION_RELEASE
  FULFILMENT
  RECEIVED
  CORRECTION
}

/// Append-only ledger (UPDATE/DELETE revoked from the app role).
model InventoryMovement {
  id              String                  @id @default(uuid(7)) @db.Uuid
  organisationId  String                  @db.Uuid
  storeId         String                  @db.Uuid
  inventoryItemId String                  @db.Uuid
  locationId      String                  @db.Uuid
  quantityName    InventoryQuantityName
  delta           Int
  /// Value after the change — makes reconciliation and audits cheap.
  resultingValue  Int
  reason          InventoryMovementReason
  referenceType   String?
  referenceId     String?                 @db.Uuid
  note            String?
  actorUserId     String?                 @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  store         Store         @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId, storeId], references: [id, storeId], onDelete: Restrict)
  location      Location      @relation(fields: [locationId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([storeId, createdAt])
  @@index([locationId])
}

// Storevia live database schema.
//
// Models are promoted here from docs/database/schema.draft.prisma one milestone
// at a time (ADR-0020). Column names, types and attributes must match the
// draft; CI (scripts/check-schema-agreement.mjs) enforces this. Back-relations
// to models that are not promoted yet are intentionally omitted.
//
// Constraints Prisma cannot express (RLS, grants, triggers, partial unique
// indexes, CHECKs, SECURITY DEFINER helpers) live in the SQL of each migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// --- Identity (Milestone 1) ---------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique @db.Citext
  emailVerified Boolean    @default(false)
  name          String
  image         String?
  locale        String     @default("en")
  timezone      String     @default("UTC")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?  @db.Timestamptz(3)

  accounts             Account[]
  sessions             Session[]
  memberships          Membership[]
  invitationsSent      Invitation[]   @relation("InvitationInvitedBy")
  invitationsAccepted  Invitation[]   @relation("InvitationAcceptedBy")
  platformStaff        PlatformStaff?
  organisationsCreated Organisation[] @relation("OrganisationCreatedBy")
  productsCreated      Product[]      @relation("ProductCreatedBy")
  productsUpdated      Product[]      @relation("ProductUpdatedBy")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @db.Uuid
  providerId            String
  accountId             String
  passwordHash          String?
  accessTokenEnc        String?
  refreshTokenEnc       String?
  idTokenEnc            String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

enum SessionRealm {
  DASHBOARD
  PLATFORM
}

model Session {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @db.Uuid
  token             String       @unique
  realm             SessionRealm @default(DASHBOARD)
  expiresAt         DateTime     @db.Timestamptz(3)
  ipAddress         String?
  userAgent         String?
  mfaVerifiedAt     DateTime?    @db.Timestamptz(3)
  reauthenticatedAt DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum PlatformRole {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  BILLING
  READ_ONLY
}

model PlatformStaff {
  userId    String       @id @db.Uuid
  role      PlatformRole
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// --- Tenancy (Milestone 1) ----------------------------------------------------

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

model Organisation {
  id           String             @id @default(uuid(7)) @db.Uuid
  name         String
  status       OrganisationStatus @default(ACTIVE)
  billingEmail String?
  country      String?            @db.Char(2)
  createdById  String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  suspendedAt  DateTime?          @db.Timestamptz(3)
  deletedAt    DateTime?          @db.Timestamptz(3)

  createdBy   User?        @relation("OrganisationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships Membership[]
  invitations Invitation[]
  stores      Store[]
  auditLogs   AuditLog[]

  billingCustomers BillingCustomer[]
  subscriptions    Subscription[]
  featureOverrides OrganisationFeatureOverride[]
  usageCounters    UsageCounter[]

  @@index([createdById])
}

enum MemberRole {
  OWNER
  ADMIN
  STORE_MANAGER
  DESIGNER
  CATALOGUE_MANAGER
  ORDER_MANAGER
  MARKETING
  SUPPORT
  VIEWER
  INVENTORY_MANAGER
  SITE_MANAGER
  CONTENT_MANAGER
  EDITOR
  AUTHOR
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organisationId String           @db.Uuid
  userId         String           @db.Uuid
  role           MemberRole
  status         MembershipStatus @default(ACTIVE)
  allStores      Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  storeAccess  MembershipStoreAccess[]

  @@unique([organisationId, userId])
  @@unique([id, organisationId])
  @@index([userId])
}

model MembershipStoreAccess {
  membershipId   String   @db.Uuid
  storeId        String   @db.Uuid
  organisationId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId, organisationId], references: [id, organisationId], onDelete: Cascade)
  store      Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@id([membershipId, storeId])
  @@index([storeId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organisationId String           @db.Uuid
  email          String           @db.Citext
  role           MemberRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @db.Timestamptz(3)
  invitedById    String           @db.Uuid
  acceptedById   String?          @db.Uuid
  acceptedAt     DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([invitedById])
  @@index([acceptedById])
}

// --- Stores (Milestone 1) -----------------------------------------------------

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// What a store is (ADR-0024). Controls onboarding, navigation emphasis and
/// suggested roles; never permissions or entitlements.
enum BusinessType {
  ECOMMERCE
  BUSINESS
  PUBLISHING
  PORTFOLIO
}

model Store {
  id               String       @id @default(uuid(7)) @db.Uuid
  organisationId   String       @db.Uuid
  name             String
  slug             String       @unique
  status           StoreStatus  @default(DRAFT)
  /// Presentation only (ADR-0024): never an authorisation input.
  businessType     BusinessType @default(ECOMMERCE)
  currency         String       @db.Char(3)
  locale           String
  timezone         String
  country          String       @db.Char(2)
  logoMediaId      String?      @db.Uuid
  faviconMediaId   String?      @db.Uuid
  contactEmail     String?
  supportEmail     String?
  nextOrderNumber  Int          @default(1001)
  suspendedAt      DateTime?    @db.Timestamptz(3)
  suspensionReason String?
  archivedAt       DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  organisation        Organisation                @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  memberAccess        MembershipStoreAccess[]
  domains             StoreDomain[]
  media               MediaAsset[]
  products            Product[]
  productOptions      ProductOption[]
  productOptionValues ProductOptionValue[]
  productVariants     ProductVariant[]
  variantOptionValues ProductVariantOptionValue[]
  productMedia        ProductMedia[]
  collections         Collection[]
  collectionProducts  CollectionProduct[]
  locations           Location[]
  inventoryItems      InventoryItem[]
  inventoryLevels     InventoryLevel[]
  inventoryMovements  InventoryMovement[]

  @@unique([id, organisationId])
  @@index([organisationId])
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

model StoreDomain {
  id                String       @id @default(uuid(7)) @db.Uuid
  organisationId    String       @db.Uuid
  storeId           String       @db.Uuid
  hostname          String       @unique
  type              DomainType
  status            DomainStatus @default(PENDING)
  verificationToken String
  isPrimary         Boolean      @default(false)
  verifiedAt        DateTime?    @db.Timestamptz(3)
  lastCheckedAt     DateTime?    @db.Timestamptz(3)
  failureReason     String?
  providerRef       String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([storeId])
  @@index([status, lastCheckedAt])
}

// --- Plans, entitlements, subscriptions (Milestone 2, ADR-0022) ---------------

enum PlanStatus {
  ACTIVE
  LEGACY
  ARCHIVED
}

/// `key` is a stable identifier for ops/seed data. Application code must
/// never branch on it — it asks the entitlement engine about features.
/// ACTIVE plans can be assigned; LEGACY plans keep existing subscribers only.
model Plan {
  id          String     @id @default(uuid(7)) @db.Uuid
  key         String     @unique
  name        String
  description String?
  status      PlanStatus @default(ACTIVE)
  isPublic    Boolean    @default(true)
  sortOrder   Int        @default(0)
  trialDays   Int        @default(14)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  prices        PlanPrice[]
  features      PlanFeature[]
  subscriptions Subscription[]
}

enum BillingInterval {
  MONTH
  YEAR
}

/// Provider-reference layer only (ADR-0022): domain logic never branches on it.
enum BillingProviderKey {
  MOCK
  RAZORPAY
  STRIPE
}

/// Provider-neutral list price (pricing metadata), BigInt minor units.
/// SQL: partial unique (planId, interval, currency) WHERE active.
model PlanPrice {
  id        String          @id @default(uuid(7)) @db.Uuid
  planId    String          @db.Uuid
  interval  BillingInterval
  currency  String          @db.Char(3)
  amount    BigInt
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
}

enum FeatureType {
  BOOLEAN
  LIMIT
  CONFIGURATION
}

/// Rows are inserted by migrations: keys are part of the code contract (the
/// closed FeatureKey union). default* is the system default, the last step of
/// resolution (override → plan → system default).
model Feature {
  id               String      @id @default(uuid(7)) @db.Uuid
  /// e.g. "store_count", "custom_domain". Referenced from code via a typed
  /// FeatureKey constant, never a free string.
  key              String      @unique
  name             String
  description      String?
  type             FeatureType
  sortOrder        Int         @default(0)
  defaultEnabled   Boolean     @default(false)
  defaultLimit     BigInt?
  defaultUnlimited Boolean     @default(false)
  defaultConfig    Json?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  plans         PlanFeature[]
  overrides     OrganisationFeatureOverride[]
  usageCounters UsageCounter[]
}

/// A complete entitlement value, validated against Feature.type by a trigger:
/// LIMIT needs exactly one of limit >= 0 / unlimited when enabled.
model PlanFeature {
  planId    String  @db.Uuid
  featureId String  @db.Uuid
  enabled   Boolean @default(true)
  limit     BigInt?
  unlimited Boolean @default(false)
  config    Json?

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([planId, featureId])
  @@index([featureId])
}

/// Staff override for one organisation and feature. A complete replacement
/// value (same shape as PlanFeature) that takes precedence over the plan.
/// Written only by platform-admin; every change is audited (ADR-0022).
model OrganisationFeatureOverride {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @db.Uuid
  featureId      String    @db.Uuid
  enabled        Boolean
  limit          BigInt?
  unlimited      Boolean   @default(false)
  config         Json?
  reason         String
  expiresAt      DateTime? @db.Timestamptz(3)
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@unique([organisationId, featureId])
  @@index([featureId])
}

model BillingCustomer {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organisationId     String             @db.Uuid
  provider           BillingProviderKey
  providerCustomerId String
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, provider])
  @@unique([provider, providerCustomerId])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// Where a subscription came from. Never changes what a status means.
enum SubscriptionSource {
  MANUAL
  MOCK
  PAYMENT_PROVIDER
}

/// SQL: partial unique (organisationId) WHERE status <> 'EXPIRED' — at most
/// one live subscription per organisation; CHECKs tie source to provider
/// columns and each status to its required dates (ADR-0022 §1–2).
/// expiresAt: scheduled end of entitlement (fixed manual term, or the access
/// end of a CANCELLED subscription); NULL = no scheduled end.
model Subscription {
  id                     String              @id @default(uuid(7)) @db.Uuid
  organisationId         String              @db.Uuid
  planId                 String              @db.Uuid
  status                 SubscriptionStatus
  source                 SubscriptionSource
  provider               BillingProviderKey?
  providerSubscriptionId String?
  billingInterval        BillingInterval?
  startedAt              DateTime            @db.Timestamptz(3)
  trialStartsAt          DateTime?           @db.Timestamptz(3)
  trialEndsAt            DateTime?           @db.Timestamptz(3)
  currentPeriodStart     DateTime?           @db.Timestamptz(3)
  currentPeriodEnd       DateTime?           @db.Timestamptz(3)
  expiresAt              DateTime?           @db.Timestamptz(3)
  cancelledAt            DateTime?           @db.Timestamptz(3)
  pastDueSince           DateTime?           @db.Timestamptz(3)
  graceEndsAt            DateTime?           @db.Timestamptz(3)
  endedAt                DateTime?           @db.Timestamptz(3)
  /// Version of the last provider snapshot applied (event time, or fetch time
  /// for adapters that re-fetch). Older snapshots are ignored as stale.
  providerSyncedAt       DateTime?           @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  events       SubscriptionEvent[]

  @@unique([id, organisationId])
  @@unique([provider, providerSubscriptionId])
  @@index([organisationId, status])
  @@index([planId])
}

/// Append-only history of subscription changes, whatever their source.
/// reason/note are staff-entered (platform-admin only; never shown to merchants).
model SubscriptionEvent {
  id              String              @id @default(uuid(7)) @db.Uuid
  subscriptionId  String              @db.Uuid
  organisationId  String              @db.Uuid
  type            String
  source          SubscriptionSource
  fromStatus      SubscriptionStatus?
  toStatus        SubscriptionStatus?
  fromPlanId      String?             @db.Uuid
  toPlanId        String?             @db.Uuid
  actorType       AuditActorType
  actorId         String?             @db.Uuid
  reason          String?
  note            String?
  providerEventId String?
  requestId       String?
  data            Json?
  occurredAt      DateTime            @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([subscriptionId, occurredAt])
  @@index([organisationId, occurredAt])
}

enum InboundWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

/// Idempotency ledger for billing-provider webhooks (platform level).
/// organisationId is filled once the event is matched to a customer.
/// outcome: short machine-readable reason for IGNORED/FAILED (never secrets).
model BillingWebhookEvent {
  id              String               @id @default(uuid(7)) @db.Uuid
  provider        BillingProviderKey
  providerEventId String
  type            String
  status          InboundWebhookStatus @default(RECEIVED)
  organisationId  String?              @db.Uuid
  attempts        Int                  @default(0)
  outcome         String?
  lastError       String?
  payload         Json
  receivedAt      DateTime             @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?            @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([organisationId, receivedAt])
}

/// Gauge counters (period = "all") are changed in the same transaction as the
/// resource they count, under a row lock. Metered counters use a period key
/// such as "2026-09". scopeKey = storeId or "" for organisation-wide usage.
/// SQL: CHECK (value >= 0).
model UsageCounter {
  organisationId String   @db.Uuid
  featureId      String   @db.Uuid
  scopeKey       String   @default("")
  period         String   @default("all")
  value          BigInt   @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([organisationId, featureId, scopeKey, period])
  @@index([featureId])
}

// --- Audit (Milestone 1) ------------------------------------------------------

enum AuditActorType {
  USER
  PLATFORM_STAFF
  API_KEY
  APP
  SYSTEM
}

model AuditLog {
  id               String         @default(uuid(7)) @db.Uuid
  organisationId   String?        @db.Uuid
  storeId          String?        @db.Uuid
  actorType        AuditActorType
  actorId          String?        @db.Uuid
  onBehalfOfUserId String?        @db.Uuid
  action           String
  entityType       String?
  entityId         String?        @db.Uuid
  metadata         Json?
  ipAddress        String?
  userAgent        String?
  requestId        String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([id, createdAt])
  @@index([organisationId, createdAt])
  @@index([storeId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// --- Background jobs (Milestone 2.5, ADR-0023) --------------------------------

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model ScheduledJob {
  name                String        @id
  intervalSeconds     Int
  slot                DateTime      @db.Timestamptz(3)
  nextRunAt           DateTime      @db.Timestamptz(3)
  attempt             Int           @default(0)
  lockedBy            String?
  lockedUntil         DateTime?     @db.Timestamptz(3)
  lastStartedAt       DateTime?     @db.Timestamptz(3)
  lastFinishedAt      DateTime?     @db.Timestamptz(3)
  lastStatus          JobRunStatus?
  consecutiveFailures Int           @default(0)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  runs JobRun[]

  @@index([nextRunAt])
}

model JobRun {
  id         String       @id @default(uuid(7)) @db.Uuid
  jobName    String
  slot       DateTime     @db.Timestamptz(3)
  attempt    Int
  workerId   String
  status     JobRunStatus
  startedAt  DateTime     @db.Timestamptz(3)
  finishedAt DateTime?    @db.Timestamptz(3)
  result     Json?
  error      String?

  job ScheduledJob @relation(fields: [jobName], references: [name], onDelete: Cascade)

  @@unique([jobName, slot, attempt])
  @@index([jobName, startedAt])
}
