// -----------------------------------------------------------------------------
// 5. Media
// -----------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
  DELETED
}

model MediaAsset {
  id               String      @id @default(uuid(7)) @db.Uuid
  organisationId   String      @db.Uuid
  storeId          String      @db.Uuid
  kind             MediaKind
  status           MediaStatus @default(PENDING_UPLOAD)
  filename         String
  /// MIME detected server-side from content (magic bytes), not the extension.
  mimeType         String?
  declaredMimeType String
  sizeBytes        BigInt?
  width            Int?
  height           Int?
  durationMs       Int?
  /// Opaque key: {organisationId}/{storeId}/{mediaId}/original — never user input.
  storageKey       String      @unique
  sha256           String?
  altText          String?
  /// Generated renditions: [{ key, width, height, format }]
  renditions       Json?
  createdById      String?     @db.Uuid
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?   @db.Timestamptz(3)

  store        Store          @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  productMedia ProductMedia[]

  @@unique([id, storeId])
  @@index([storeId, createdAt])
  @@index([storeId, kind, status])
}

// -----------------------------------------------------------------------------
// 6. Catalogue
// -----------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// SQL: partial unique (storeId, handle) WHERE deletedAt IS NULL;
/// GIN full-text index over title/tags (see search ADR); CHECK
/// catalogue_tags_valid(tags) and a GIN index over lower-cased tags
/// (Product_tags_folded) for the tag filter.
model Product {
  id              String        @id @default(uuid(7)) @db.Uuid
  organisationId  String        @db.Uuid
  storeId         String        @db.Uuid
  title           String
  handle          String
  status          ProductStatus @default(DRAFT)
  /// Canonical rich text as Tiptap/ProseMirror JSON; HTML is derived.
  descriptionDoc  Json?
  /// Sanitised HTML rendered from descriptionDoc (cache, never user-authored).
  descriptionHtml String?
  productType     String?
  vendor          String?
  /// Merchant labels: normalised by the service (at most 50, each at most
  /// 40 characters, de-duplicated ignoring case). Not storefront navigation.
  tags            String[]
  /// Global product taxonomy (ProductCategory); null when not categorised.
  categoryCode    String?
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?     @db.Timestamptz(3)
  /// Set when the product is archived; cleared when it is restored (ADR-0027).
  archivedAt      DateTime?     @db.Timestamptz(3)
  /// Authorship; kept when the user is deleted (ADR-0027).
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?     @db.Timestamptz(3)

  store       Store               @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  createdBy   User?               @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?               @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  category    ProductCategory?    @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  options     ProductOption[]
  variants    ProductVariant[]
  media       ProductMedia[]
  collections CollectionProduct[]
  orderLines  OrderLine[]

  @@unique([id, storeId])
  @@index([createdById])
  @@index([updatedById])
  @@index([storeId, status, updatedAt])
  // Leads with categoryCode for the foreign key; serves the store's category filter.
  @@index([categoryCode, storeId])
}

/// Global product taxonomy (erd.md §4.3): platform reference data, no tenant
/// columns. Loaded from packages/database/prisma/reference/product-categories.json
/// by `pnpm db:seed`; application roles may only read it. Codes are stable and
/// never reused: a category removed from the file is deactivated, never deleted.
/// SQL: CHECKs on code, name, level and path; trigram index on lower(path).
model ProductCategory {
  code       String   @id
  name       String
  parentCode String?
  /// 1 for a top-level category.
  level      Int
  /// Names from the root, e.g. "Home & Garden > Kitchen & Dining > Cookware".
  path       String
  /// Order among siblings.
  position   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentCode], references: [code], onDelete: Restrict)
  children ProductCategory[] @relation("ProductCategoryTree")
  products Product[]

  @@index([parentCode, position])
}

/// e.g. "Size", "Colour". Max 3 options per product (service rule).
model ProductOption {
  id             String @id @default(uuid(7)) @db.Uuid
  organisationId String @db.Uuid
  storeId        String @db.Uuid
  productId      String @db.Uuid
  name           String
  position       Int

  store         Store                       @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  product       Product                     @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  values        ProductOptionValue[]
  variantValues ProductVariantOptionValue[]

  @@unique([productId, name])
  @@unique([productId, position])
  @@unique([id, storeId])
  @@unique([id, productId])
  @@index([storeId])
}

model ProductOptionValue {
  id             String @id @default(uuid(7)) @db.Uuid
  organisationId String @db.Uuid
  storeId        String @db.Uuid
  optionId       String @db.Uuid
  value          String
  position       Int

  store         Store                       @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  option        ProductOption               @relation(fields: [optionId, storeId], references: [id, storeId], onDelete: Cascade)
  variantValues ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@unique([id, storeId])
  @@unique([id, optionId])
  @@index([storeId])
}

enum InventoryPolicy {
  DENY
  CONTINUE
}

/// Every product has >= 1 variant. A product without options has exactly one
/// "default" variant (optionSignature = ""). Prices are store-currency minor
/// units; `currency` is stored explicitly so every amount carries its currency.
/// SQL: partial unique (storeId, sku) WHERE sku IS NOT NULL AND deletedAt IS NULL;
///      CHECK (priceAmount >= 0), CHECK (compareAtAmount IS NULL OR compareAtAmount > priceAmount).
model ProductVariant {
  id               String          @id @default(uuid(7)) @db.Uuid
  organisationId   String          @db.Uuid
  storeId          String          @db.Uuid
  productId        String          @db.Uuid
  title            String
  /// Sorted "optionId=valueId" pairs; unique per product. Prevents duplicates.
  optionSignature  String
  sku              String?
  barcode          String?
  currency         String          @db.Char(3)
  priceAmount      BigInt
  compareAtAmount  BigInt?
  costAmount       BigInt?
  weightGrams      Int?
  requiresShipping Boolean         @default(true)
  taxable          Boolean         @default(true)
  taxCode          String?
  inventoryPolicy  InventoryPolicy @default(DENY)
  imageMediaId     String?         @db.Uuid
  position         Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?       @db.Timestamptz(3)

  store         Store                       @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  product       Product                     @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  optionValues  ProductVariantOptionValue[]
  inventoryItem InventoryItem?
  cartLines     CartLine[]
  orderLines    OrderLine[]

  @@unique([productId, optionSignature])
  @@unique([id, storeId])
  @@index([storeId, sku])
}

/// Exactly one value per option per variant (unique variantId+optionId);
/// the value must belong to that option (composite FK optionValueId+optionId).
model ProductVariantOptionValue {
  organisationId String @db.Uuid
  storeId        String @db.Uuid
  variantId      String @db.Uuid
  optionId       String @db.Uuid
  optionValueId  String @db.Uuid

  store       Store              @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  variant     ProductVariant     @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade)
  option      ProductOption      @relation(fields: [optionId, storeId], references: [id, storeId], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([optionValueId])
  @@index([storeId])
  @@index([optionId])
}

model ProductMedia {
  id             String  @id @default(uuid(7)) @db.Uuid
  organisationId String  @db.Uuid
  storeId        String  @db.Uuid
  productId      String  @db.Uuid
  mediaAssetId   String  @db.Uuid
  position       Int
  altText        String?

  store      Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  product    Product    @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([productId, mediaAssetId])
  @@index([productId, position])
  @@index([storeId])
  @@index([mediaAssetId])
}

enum CollectionType {
  MANUAL
  SMART
}

enum CollectionSortOrder {
  MANUAL
  BEST_SELLING
  TITLE_ASC
  TITLE_DESC
  PRICE_ASC
  PRICE_DESC
  CREATED_DESC
}

/// SQL: partial unique (storeId, handle) WHERE deletedAt IS NULL.
model Collection {
  id              String              @id @default(uuid(7)) @db.Uuid
  organisationId  String              @db.Uuid
  storeId         String              @db.Uuid
  title           String
  handle          String
  type            CollectionType      @default(MANUAL)
  /// SMART collections: validated rule set (schema in packages/validation).
  rules           Json?
  sortOrder       CollectionSortOrder @default(MANUAL)
  descriptionDoc  Json?
  descriptionHtml String?
  imageMediaId    String?             @db.Uuid
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?           @db.Timestamptz(3)
  /// Set when the collection is archived (hidden, restorable); ADR-0027.
  archivedAt      DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?           @db.Timestamptz(3)

  store    Store               @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  products CollectionProduct[]

  @@unique([id, storeId])
  @@index([storeId, updatedAt])
}

model CollectionProduct {
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  collectionId   String   @db.Uuid
  productId      String   @db.Uuid
  position       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  store      Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  collection Collection @relation(fields: [collectionId, storeId], references: [id, storeId], onDelete: Cascade)
  product    Product    @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
  @@index([storeId])
}

// -----------------------------------------------------------------------------
// 7. Inventory (location-aware, movement-audited)
// -----------------------------------------------------------------------------

model Location {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organisationId      String    @db.Uuid
  storeId             String    @db.Uuid
  name                String
  /// Short stable reference ("MAIN", "WH-2"); SQL: partial unique (storeId, code)
  /// WHERE deletedAt IS NULL (ADR-0027).
  code                String
  addressLine1        String?
  addressLine2        String?
  city                String?
  region              String?
  postalCode          String?
  countryCode         String    @db.Char(2)
  phone               String?
  isActive            Boolean   @default(true)
  fulfilsOnlineOrders Boolean   @default(true)
  /// Lower value = preferred when allocating online orders.
  priority            Int       @default(0)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime? @db.Timestamptz(3)

  store        Store                  @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  levels       InventoryLevel[]
  movements    InventoryMovement[]
  reservations InventoryReservation[]
  fulfilments  Fulfilment[]

  @@unique([id, storeId])
  @@index([storeId])
}

/// 1:1 with ProductVariant. Separated so inventory can later exist for
/// non-variant stock (bundles, components) without touching the catalogue.
model InventoryItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @db.Uuid
  storeId         String   @db.Uuid
  variantId       String   @unique @db.Uuid
  tracked         Boolean  @default(true)
  countryOfOrigin String?  @db.Char(2)
  hsCode          String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  store        Store                  @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  variant      ProductVariant         @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade)
  levels       InventoryLevel[]
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@unique([id, storeId])
  @@unique([variantId, storeId])
  @@index([storeId])
}

/// on hand = available + reserved. Quantities change ONLY through the
/// inventory service, which writes an InventoryMovement in the same
/// transaction. SQL: CHECK (reserved >= 0 AND incoming >= 0).
model InventoryLevel {
  id              String   @id @default(uuid(7)) @db.Uuid
  organisationId  String   @db.Uuid
  storeId         String   @db.Uuid
  inventoryItemId String   @db.Uuid
  locationId      String   @db.Uuid
  available       Int      @default(0)
  reserved        Int      @default(0)
  incoming        Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  store         Store         @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId, storeId], references: [id, storeId], onDelete: Cascade)
  location      Location      @relation(fields: [locationId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([inventoryItemId, locationId])
  @@index([locationId])
  @@index([storeId])
}

enum InventoryQuantityName {
  AVAILABLE
  RESERVED
  INCOMING
}

enum InventoryMovementReason {
  /// First stock recorded for an item at a location (ADR-0027).
  INITIAL
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  TRANSFER
  RESTOCK
  CANCELLATION
  RESERVATION
  RESERVATION_RELEASE
  FULFILMENT
  RECEIVED
  CORRECTION
}

/// Append-only ledger (UPDATE/DELETE revoked from the app role).
model InventoryMovement {
  id              String                  @id @default(uuid(7)) @db.Uuid
  organisationId  String                  @db.Uuid
  storeId         String                  @db.Uuid
  inventoryItemId String                  @db.Uuid
  locationId      String                  @db.Uuid
  quantityName    InventoryQuantityName
  delta           Int
  /// Value after the change — makes reconciliation and audits cheap.
  resultingValue  Int
  reason          InventoryMovementReason
  referenceType   String?
  referenceId     String?                 @db.Uuid
  note            String?
  actorUserId     String?                 @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  store         Store         @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId, storeId], references: [id, storeId], onDelete: Restrict)
  location      Location      @relation(fields: [locationId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([storeId, createdAt])
  @@index([locationId])
}

// Storevia live database schema.
//
// Models are promoted here from docs/database/schema.draft.prisma one milestone
// at a time (ADR-0020). Column names, types and attributes must match the
// draft; CI (scripts/check-schema-agreement.mjs) enforces this. Back-relations
// to models that are not promoted yet are intentionally omitted.
//
// Constraints Prisma cannot express (RLS, grants, triggers, partial unique
// indexes, CHECKs, SECURITY DEFINER helpers) live in the SQL of each migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// --- Identity (Milestone 1) ---------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  email         String     @unique @db.Citext
  emailVerified Boolean    @default(false)
  name          String
  image         String?
  locale        String     @default("en")
  timezone      String     @default("UTC")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?  @db.Timestamptz(3)

  accounts             Account[]
  sessions             Session[]
  memberships          Membership[]
  invitationsSent      Invitation[]   @relation("InvitationInvitedBy")
  invitationsAccepted  Invitation[]   @relation("InvitationAcceptedBy")
  platformStaff        PlatformStaff?
  organisationsCreated Organisation[] @relation("OrganisationCreatedBy")
  productsCreated      Product[]      @relation("ProductCreatedBy")
  productsUpdated      Product[]      @relation("ProductUpdatedBy")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @db.Uuid
  providerId            String
  accountId             String
  passwordHash          String?
  accessTokenEnc        String?
  refreshTokenEnc       String?
  idTokenEnc            String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

enum SessionRealm {
  DASHBOARD
  PLATFORM
}

model Session {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @db.Uuid
  token             String       @unique
  realm             SessionRealm @default(DASHBOARD)
  expiresAt         DateTime     @db.Timestamptz(3)
  ipAddress         String?
  userAgent         String?
  mfaVerifiedAt     DateTime?    @db.Timestamptz(3)
  reauthenticatedAt DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum PlatformRole {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  BILLING
  READ_ONLY
}

model PlatformStaff {
  userId    String       @id @db.Uuid
  role      PlatformRole
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// --- Tenancy (Milestone 1) ----------------------------------------------------

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

model Organisation {
  id           String             @id @default(uuid(7)) @db.Uuid
  name         String
  status       OrganisationStatus @default(ACTIVE)
  billingEmail String?
  country      String?            @db.Char(2)
  createdById  String?            @db.Uuid
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  suspendedAt  DateTime?          @db.Timestamptz(3)
  deletedAt    DateTime?          @db.Timestamptz(3)

  createdBy   User?        @relation("OrganisationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships Membership[]
  invitations Invitation[]
  stores      Store[]
  auditLogs   AuditLog[]

  billingCustomers BillingCustomer[]
  subscriptions    Subscription[]
  featureOverrides OrganisationFeatureOverride[]
  usageCounters    UsageCounter[]

  @@index([createdById])
}

enum MemberRole {
  OWNER
  ADMIN
  STORE_MANAGER
  DESIGNER
  CATALOGUE_MANAGER
  ORDER_MANAGER
  MARKETING
  SUPPORT
  VIEWER
  INVENTORY_MANAGER
  SITE_MANAGER
  CONTENT_MANAGER
  EDITOR
  AUTHOR
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organisationId String           @db.Uuid
  userId         String           @db.Uuid
  role           MemberRole
  status         MembershipStatus @default(ACTIVE)
  allStores      Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  storeAccess  MembershipStoreAccess[]

  @@unique([organisationId, userId])
  @@unique([id, organisationId])
  @@index([userId])
}

model MembershipStoreAccess {
  membershipId   String   @db.Uuid
  storeId        String   @db.Uuid
  organisationId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId, organisationId], references: [id, organisationId], onDelete: Cascade)
  store      Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@id([membershipId, storeId])
  @@index([storeId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organisationId String           @db.Uuid
  email          String           @db.Citext
  role           MemberRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @db.Timestamptz(3)
  invitedById    String           @db.Uuid
  acceptedById   String?          @db.Uuid
  acceptedAt     DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([invitedById])
  @@index([acceptedById])
}

// --- Stores (Milestone 1) -----------------------------------------------------

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// What a store is (ADR-0024). Controls onboarding, navigation emphasis and
/// suggested roles; never permissions or entitlements.
enum BusinessType {
  ECOMMERCE
  BUSINESS
  PUBLISHING
  PORTFOLIO
}

model Store {
  id               String       @id @default(uuid(7)) @db.Uuid
  organisationId   String       @db.Uuid
  name             String
  slug             String       @unique
  status           StoreStatus  @default(DRAFT)
  /// Presentation only (ADR-0024): never an authorisation input.
  businessType     BusinessType @default(ECOMMERCE)
  currency         String       @db.Char(3)
  locale           String
  timezone         String
  country          String       @db.Char(2)
  logoMediaId      String?      @db.Uuid
  faviconMediaId   String?      @db.Uuid
  contactEmail     String?
  supportEmail     String?
  nextOrderNumber  Int          @default(1001)
  suspendedAt      DateTime?    @db.Timestamptz(3)
  suspensionReason String?
  archivedAt       DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  organisation          Organisation                @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  memberAccess          MembershipStoreAccess[]
  domains               StoreDomain[]
  slugHistory           StoreSlugHistory[]
  carts                 Cart[]
  cartLines             CartLine[]
  pages                 Page[]
  pageVersions          PageVersion[]
  storeThemes           StoreTheme[]
  navigations           Navigation[]
  outboxEvents          OutboxEvent[]
  media                 MediaAsset[]
  products              Product[]
  productOptions        ProductOption[]
  productOptionValues   ProductOptionValue[]
  productVariants       ProductVariant[]
  variantOptionValues   ProductVariantOptionValue[]
  productMedia          ProductMedia[]
  collections           Collection[]
  collectionProducts    CollectionProduct[]
  locations             Location[]
  inventoryItems        InventoryItem[]
  inventoryLevels       InventoryLevel[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  customers             Customer[]
  checkouts             Checkout[]
  discounts             Discount[]
  discountCodes         DiscountCode[]
  discountRedemptions   DiscountRedemption[]
  shippingZones         ShippingZone[]
  shippingZoneCountries ShippingZoneCountry[]
  shippingRates         ShippingRate[]
  taxConfiguration      TaxConfiguration?
  taxRates              TaxRate[]
  orders                Order[]
  orderLines            OrderLine[]
  orderAddresses        OrderAddress[]
  orderDiscounts        OrderDiscount[]
  orderShippingLines    OrderShippingLine[]
  orderTaxLines         OrderTaxLine[]
  orderEvents           OrderEvent[]
  paymentConnections    PaymentProviderConnection[]
  payments              Payment[]
  paymentWebhookEvents  PaymentWebhookEvent[]
  refunds               Refund[]
  refundLines           RefundLine[]
  fulfilments           Fulfilment[]
  fulfilmentLines       FulfilmentLine[]
  orderNotifications    OrderNotification[]

  @@unique([id, organisationId])
  @@index([organisationId])
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
}

model StoreDomain {
  id                String       @id @default(uuid(7)) @db.Uuid
  organisationId    String       @db.Uuid
  storeId           String       @db.Uuid
  hostname          String       @unique
  type              DomainType
  status            DomainStatus @default(PENDING)
  verificationToken String
  isPrimary         Boolean      @default(false)
  verifiedAt        DateTime?    @db.Timestamptz(3)
  lastCheckedAt     DateTime?    @db.Timestamptz(3)
  failureReason     String?
  providerRef       String?
  /// Checks since the last state change: verification backoff and the
  /// monitoring streak of an ACTIVE domain (ADR-0032 §4).
  checkAttempts     Int          @default(0)
  /// The hosting provider's DNS instructions ([{ type, name, value, purpose }]),
  /// stored so the dashboard never waits on the provider.
  dnsRecords        Json?
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([storeId])
  @@index([status, lastCheckedAt])
}

// --- Plans, entitlements, subscriptions (Milestone 2, ADR-0022) ---------------

enum PlanStatus {
  ACTIVE
  LEGACY
  ARCHIVED
}

/// `key` is a stable identifier for ops/seed data. Application code must
/// never branch on it — it asks the entitlement engine about features.
/// ACTIVE plans can be assigned; LEGACY plans keep existing subscribers only.
model Plan {
  id          String     @id @default(uuid(7)) @db.Uuid
  key         String     @unique
  name        String
  description String?
  status      PlanStatus @default(ACTIVE)
  isPublic    Boolean    @default(true)
  sortOrder   Int        @default(0)
  trialDays   Int        @default(14)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  prices        PlanPrice[]
  features      PlanFeature[]
  subscriptions Subscription[]
}

enum BillingInterval {
  MONTH
  YEAR
}

/// Provider-reference layer only (ADR-0022): domain logic never branches on it.
enum BillingProviderKey {
  MOCK
  RAZORPAY
  STRIPE
}

/// Provider-neutral list price (pricing metadata), BigInt minor units.
/// SQL: partial unique (planId, interval, currency) WHERE active.
model PlanPrice {
  id        String          @id @default(uuid(7)) @db.Uuid
  planId    String          @db.Uuid
  interval  BillingInterval
  currency  String          @db.Char(3)
  amount    BigInt
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
}

enum FeatureType {
  BOOLEAN
  LIMIT
  CONFIGURATION
}

/// Rows are inserted by migrations: keys are part of the code contract (the
/// closed FeatureKey union). default* is the system default, the last step of
/// resolution (override → plan → system default).
model Feature {
  id               String      @id @default(uuid(7)) @db.Uuid
  /// e.g. "store_count", "custom_domain". Referenced from code via a typed
  /// FeatureKey constant, never a free string.
  key              String      @unique
  name             String
  description      String?
  type             FeatureType
  sortOrder        Int         @default(0)
  defaultEnabled   Boolean     @default(false)
  defaultLimit     BigInt?
  defaultUnlimited Boolean     @default(false)
  defaultConfig    Json?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  plans         PlanFeature[]
  overrides     OrganisationFeatureOverride[]
  usageCounters UsageCounter[]
}

/// A complete entitlement value, validated against Feature.type by a trigger:
/// LIMIT needs exactly one of limit >= 0 / unlimited when enabled.
model PlanFeature {
  planId    String  @db.Uuid
  featureId String  @db.Uuid
  enabled   Boolean @default(true)
  limit     BigInt?
  unlimited Boolean @default(false)
  config    Json?

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([planId, featureId])
  @@index([featureId])
}

/// Staff override for one organisation and feature. A complete replacement
/// value (same shape as PlanFeature) that takes precedence over the plan.
/// Written only by platform-admin; every change is audited (ADR-0022).
model OrganisationFeatureOverride {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @db.Uuid
  featureId      String    @db.Uuid
  enabled        Boolean
  limit          BigInt?
  unlimited      Boolean   @default(false)
  config         Json?
  reason         String
  expiresAt      DateTime? @db.Timestamptz(3)
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@unique([organisationId, featureId])
  @@index([featureId])
}

model BillingCustomer {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organisationId     String             @db.Uuid
  provider           BillingProviderKey
  providerCustomerId String
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, provider])
  @@unique([provider, providerCustomerId])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// Where a subscription came from. Never changes what a status means.
enum SubscriptionSource {
  MANUAL
  MOCK
  PAYMENT_PROVIDER
}

/// SQL: partial unique (organisationId) WHERE status <> 'EXPIRED' — at most
/// one live subscription per organisation; CHECKs tie source to provider
/// columns and each status to its required dates (ADR-0022 §1–2).
/// expiresAt: scheduled end of entitlement (fixed manual term, or the access
/// end of a CANCELLED subscription); NULL = no scheduled end.
model Subscription {
  id                     String              @id @default(uuid(7)) @db.Uuid
  organisationId         String              @db.Uuid
  planId                 String              @db.Uuid
  status                 SubscriptionStatus
  source                 SubscriptionSource
  provider               BillingProviderKey?
  providerSubscriptionId String?
  billingInterval        BillingInterval?
  startedAt              DateTime            @db.Timestamptz(3)
  trialStartsAt          DateTime?           @db.Timestamptz(3)
  trialEndsAt            DateTime?           @db.Timestamptz(3)
  currentPeriodStart     DateTime?           @db.Timestamptz(3)
  currentPeriodEnd       DateTime?           @db.Timestamptz(3)
  expiresAt              DateTime?           @db.Timestamptz(3)
  cancelledAt            DateTime?           @db.Timestamptz(3)
  pastDueSince           DateTime?           @db.Timestamptz(3)
  graceEndsAt            DateTime?           @db.Timestamptz(3)
  endedAt                DateTime?           @db.Timestamptz(3)
  /// Version of the last provider snapshot applied (event time, or fetch time
  /// for adapters that re-fetch). Older snapshots are ignored as stale.
  providerSyncedAt       DateTime?           @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  plan         Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  events       SubscriptionEvent[]

  @@unique([id, organisationId])
  @@unique([provider, providerSubscriptionId])
  @@index([organisationId, status])
  @@index([planId])
}

/// Append-only history of subscription changes, whatever their source.
/// reason/note are staff-entered (platform-admin only; never shown to merchants).
model SubscriptionEvent {
  id              String              @id @default(uuid(7)) @db.Uuid
  subscriptionId  String              @db.Uuid
  organisationId  String              @db.Uuid
  type            String
  source          SubscriptionSource
  fromStatus      SubscriptionStatus?
  toStatus        SubscriptionStatus?
  fromPlanId      String?             @db.Uuid
  toPlanId        String?             @db.Uuid
  actorType       AuditActorType
  actorId         String?             @db.Uuid
  reason          String?
  note            String?
  providerEventId String?
  requestId       String?
  data            Json?
  occurredAt      DateTime            @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([subscriptionId, occurredAt])
  @@index([organisationId, occurredAt])
}

enum InboundWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

/// Idempotency ledger for billing-provider webhooks (platform level).
/// organisationId is filled once the event is matched to a customer.
/// outcome: short machine-readable reason for IGNORED/FAILED (never secrets).
model BillingWebhookEvent {
  id              String               @id @default(uuid(7)) @db.Uuid
  provider        BillingProviderKey
  providerEventId String
  type            String
  status          InboundWebhookStatus @default(RECEIVED)
  organisationId  String?              @db.Uuid
  attempts        Int                  @default(0)
  outcome         String?
  lastError       String?
  payload         Json
  receivedAt      DateTime             @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?            @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([organisationId, receivedAt])
}

/// Gauge counters (period = "all") are changed in the same transaction as the
/// resource they count, under a row lock. Metered counters use a period key
/// such as "2026-09". scopeKey = storeId or "" for organisation-wide usage.
/// SQL: CHECK (value >= 0).
model UsageCounter {
  organisationId String   @db.Uuid
  featureId      String   @db.Uuid
  scopeKey       String   @default("")
  period         String   @default("all")
  value          BigInt   @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([organisationId, featureId, scopeKey, period])
  @@index([featureId])
}

// --- Audit (Milestone 1) ------------------------------------------------------

enum AuditActorType {
  USER
  PLATFORM_STAFF
  API_KEY
  APP
  SYSTEM
}

model AuditLog {
  id               String         @default(uuid(7)) @db.Uuid
  organisationId   String?        @db.Uuid
  storeId          String?        @db.Uuid
  actorType        AuditActorType
  actorId          String?        @db.Uuid
  onBehalfOfUserId String?        @db.Uuid
  action           String
  entityType       String?
  entityId         String?        @db.Uuid
  metadata         Json?
  ipAddress        String?
  userAgent        String?
  requestId        String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@id([id, createdAt])
  @@index([organisationId, createdAt])
  @@index([storeId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

// --- Background jobs (Milestone 2.5, ADR-0023) --------------------------------

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model ScheduledJob {
  name                String        @id
  intervalSeconds     Int
  slot                DateTime      @db.Timestamptz(3)
  nextRunAt           DateTime      @db.Timestamptz(3)
  attempt             Int           @default(0)
  lockedBy            String?
  lockedUntil         DateTime?     @db.Timestamptz(3)
  lastStartedAt       DateTime?     @db.Timestamptz(3)
  lastFinishedAt      DateTime?     @db.Timestamptz(3)
  lastStatus          JobRunStatus?
  consecutiveFailures Int           @default(0)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  runs JobRun[]

  @@index([nextRunAt])
}

model JobRun {
  id         String       @id @default(uuid(7)) @db.Uuid
  jobName    String
  slot       DateTime     @db.Timestamptz(3)
  attempt    Int
  workerId   String
  status     JobRunStatus
  startedAt  DateTime     @db.Timestamptz(3)
  finishedAt DateTime?    @db.Timestamptz(3)
  result     Json?
  error      String?

  job ScheduledJob @relation(fields: [jobName], references: [name], onDelete: Cascade)

  @@unique([jobName, slot, attempt])
  @@index([jobName, startedAt])
}

// -----------------------------------------------------------------------------
// Storefront engine (Milestone 4, ADR-0028)
// -----------------------------------------------------------------------------

/// A slug a store used before (ADR-0028 §12). Kept forever: no other store
/// can claim it, so old links can't be taken over. The old platform hostname
/// stays as a non-primary StoreDomain and redirects to the primary.
model StoreSlugHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  slug           String   @unique
  retiredAt      DateTime @default(now()) @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([storeId])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  MERGED
}

/// Carts never store prices — prices are always recomputed server-side.
model Cart {
  id             String     @id @default(uuid(7)) @db.Uuid
  organisationId String     @db.Uuid
  storeId        String     @db.Uuid
  /// Hash of the opaque cart cookie token.
  tokenHash      String     @unique
  customerId     String?    @db.Uuid
  currency       String     @db.Char(3)
  status         CartStatus @default(ACTIVE)
  expiresAt      DateTime   @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  store     Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  lines     CartLine[]
  checkouts Checkout[]

  @@unique([id, storeId])
  @@index([storeId, status, updatedAt])
  @@index([customerId])
}

model CartLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  cartId         String   @db.Uuid
  variantId      String   @db.Uuid
  quantity       Int
  attributes     Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  store   Store          @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  cart    Cart           @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([storeId])
  @@index([variantId])
}

enum PageKind {
  HOME
  STANDARD
  PRODUCT_TEMPLATE
  COLLECTION_TEMPLATE
  SEARCH_TEMPLATE
  NOT_FOUND
}

/// Pages belong to the store, not to a theme (ADR-0012).
/// SQL: partial unique (storeId, handle) WHERE deletedAt IS NULL;
///      partial unique (storeId, kind) WHERE kind <> 'STANDARD' AND deletedAt IS NULL.
model Page {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organisationId     String    @db.Uuid
  storeId            String    @db.Uuid
  kind               PageKind  @default(STANDARD)
  title              String
  handle             String
  seoTitle           String?
  seoDescription     String?
  /// The live version. Changed only by publishPage()/unpublishPage().
  publishedVersionId String?   @unique @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  store            Store         @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  versions         PageVersion[] @relation("PageVersions")
  publishedVersion PageVersion?  @relation("PagePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)

  @@unique([id, storeId])
  @@index([storeId, kind])
}

enum PageVersionState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// document = PageDocument JSON (docs/architecture/07-page-builder-document.md).
/// SQL: partial unique (pageId) WHERE state = 'DRAFT';
///      partial unique (pageId) WHERE state = 'PUBLISHED';
///      trigger: document is immutable once state <> 'DRAFT'.
model PageVersion {
  id               String           @id @default(uuid(7)) @db.Uuid
  organisationId   String           @db.Uuid
  storeId          String           @db.Uuid
  pageId           String           @db.Uuid
  versionNumber    Int
  state            PageVersionState @default(DRAFT)
  schemaVersion    Int
  document         Json
  documentHash     String
  /// Optimistic-concurrency counter for autosave (If-Match style).
  revision         Int              @default(0)
  basedOnVersionId String?          @db.Uuid
  createdById      String?          @db.Uuid
  updatedById      String?          @db.Uuid
  publishedById    String?          @db.Uuid
  publishedAt      DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  store        Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  page         Page  @relation("PageVersions", fields: [pageId, storeId], references: [id, storeId], onDelete: Restrict)
  publishedFor Page? @relation("PagePublishedVersion")

  @@unique([pageId, versionNumber])
  /// Lets the deferred Page_published_pointer trigger check that a page only
  /// publishes one of its own versions (Prisma can't model the composite FK).
  @@unique([id, pageId])
  @@index([pageId, state])
  @@index([storeId])
}

enum StoreThemeRole {
  LIVE
  UNPUBLISHED
}

/// A store's installed theme and its customised settings (design-token
/// inputs, ADR-0030 §7, 08-themes §10). Themes are first-party code
/// packages (`themeKey`); `themeVersion` is the package version the settings
/// were saved for (older ones are migrated on read). Each theme is installed
/// at most once per store; `previewedAt` marks the installed theme an editor
/// chose to preview (the storefront preview shows the latest one).
/// SQL: partial unique (storeId) WHERE role = 'LIVE'; settings are JSON
/// objects with a size bound; validated by the theme engine before every write.
model StoreTheme {
  id                String         @id @default(uuid(7)) @db.Uuid
  organisationId    String         @db.Uuid
  storeId           String         @db.Uuid
  themeKey          String
  themeVersion      Int            @default(1)
  name              String
  role              StoreThemeRole @default(UNPUBLISHED)
  draftSettings     Json
  publishedSettings Json?
  settingsRevision  Int            @default(0)
  publishedAt       DateTime?      @db.Timestamptz(3)
  publishedById     String?        @db.Uuid
  previewedAt       DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([storeId, themeKey])
  @@index([storeId])
}

/// A store's menus (ADR-0030 §8): handles `main` and `footer`. `items` is a
/// validated JSON array of { id, label, link } using the page documents'
/// typed link targets; `revision` is the optimistic-concurrency counter.
model Navigation {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  handle         String
  title          String
  items          Json     @default("[]")
  revision       Int      @default(0)
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([storeId, handle])
  @@unique([id, storeId])
}

/// Transactional outbox: domain events written in the same transaction as the
/// state change, dispatched by the worker (webhooks, cache purge, email...).
model OutboxEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @db.Uuid
  storeId        String    @db.Uuid
  type           String
  entityType     String
  entityId       String    @db.Uuid
  payload        Json
  occurredAt     DateTime  @default(now()) @db.Timestamptz(3)
  dispatchedAt   DateTime? @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([id, storeId])
  @@index([dispatchedAt, occurredAt])
  @@index([storeId])
}

// -----------------------------------------------------------------------------
// Milestone 6: checkout, customers, orders, payments (ADR-0031)
// -----------------------------------------------------------------------------

enum CheckoutStatus {
  OPEN
  PAYMENT_PENDING
  COMPLETED
  EXPIRED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountMethod {
  CODE
  AUTOMATIC
}

enum DiscountStatus {
  ACTIVE
  DISABLED
}

enum DiscountTarget {
  ALL
  PRODUCTS
  COLLECTIONS
}

enum RedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum ShippingRateType {
  FLAT
  WEIGHT_BASED
  PRICE_BASED
}

enum OrderPaymentStatus {
  PENDING
  AUTHORISED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  VOIDED
}

enum OrderFulfilmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

/// Cancellation is the order's own state, separate from payment and
/// fulfilment (ADR-0031 §5). "Completed" is derived, not stored.
enum OrderStatus {
  OPEN
  CANCELLED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum PaymentProviderMode {
  TEST
  LIVE
}

enum PaymentConnectionStatus {
  PENDING
  ACTIVE
  DISABLED
  ERROR
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORISED
  CAPTURED
  PARTIALLY_CAPTURED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum FulfilmentState {
  PENDING
  SUCCESS
  CANCELLED
}

enum NotificationKind {
  ORDER_CONFIRMATION
  ORDER_CANCELLED
  ORDER_FULFILLED
  REFUND_CREATED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// SQL: partial unique (storeId, lower(email)) WHERE email IS NOT NULL AND deletedAt IS NULL.
model Customer {
  id             String    @id @default(uuid(7)) @db.Uuid
  organisationId String    @db.Uuid
  storeId        String    @db.Uuid
  email          String?   @db.Citext
  phone          String?
  firstName      String?
  lastName       String?
  note           String?
  tags           String[]
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  store       Store                @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  checkouts   Checkout[]
  orders      Order[]
  redemptions DiscountRedemption[]

  @@unique([id, storeId])
  @@index([storeId, createdAt])
}

/// Totals are the last SERVER-computed quote; they are recomputed and
/// compared (pricingHash) immediately before payment is initiated.
model Checkout {
  id               String         @id @default(uuid(7)) @db.Uuid
  organisationId   String         @db.Uuid
  storeId          String         @db.Uuid
  cartId           String         @db.Uuid
  tokenHash        String         @unique
  customerId       String?        @db.Uuid
  email            String?
  status           CheckoutStatus @default(OPEN)
  currency         String         @db.Char(3)
  shippingAddress  Json?
  billingAddress   Json?
  shippingRateId   String?        @db.Uuid
  /// One code per checkout in M6 (ADR-0031 §7), stored upper-cased.
  discountCode     String?
  subtotalAmount   BigInt         @default(0)
  discountAmount   BigInt         @default(0)
  shippingAmount   BigInt         @default(0)
  taxAmount        BigInt         @default(0)
  totalAmount      BigInt         @default(0)
  pricingHash      String?
  /// The itemised server quote (lines, allocations, tax and shipping lines)
  /// the order is created from; never supplied by the browser.
  quote            Json?
  pricedAt         DateTime?      @db.Timestamptz(3)
  expiresAt        DateTime       @db.Timestamptz(3)
  completedOrderId String?        @unique @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  store        Store                  @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  cart         Cart                   @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Restrict)
  customer     Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservations InventoryReservation[]
  payments     Payment[]

  @@unique([id, storeId])
  @@index([storeId, status, updatedAt])
  @@index([cartId])
  @@index([customerId])
}

/// Short-lived holds taken when a checkout enters payment.
model InventoryReservation {
  id              String            @id @default(uuid(7)) @db.Uuid
  organisationId  String            @db.Uuid
  storeId         String            @db.Uuid
  inventoryItemId String            @db.Uuid
  locationId      String            @db.Uuid
  checkoutId      String?           @db.Uuid
  orderId         String?           @db.Uuid
  /// Set when the reservation is converted: the order line it holds stock for.
  orderLineId     String?           @db.Uuid
  quantity        Int
  status          ReservationStatus @default(ACTIVE)
  expiresAt       DateTime          @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  store         Store         @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId, storeId], references: [id, storeId], onDelete: Restrict)
  location      Location      @relation(fields: [locationId, storeId], references: [id, storeId], onDelete: Restrict)
  checkout      Checkout?     @relation(fields: [checkoutId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([checkoutId])
  @@index([orderId])
  @@index([storeId])
  @@index([inventoryItemId])
  @@index([locationId])
}

/// PERCENTAGE uses percentageBps (1000 = 10%); FIXED_AMOUNT uses amount +
/// currency. SQL CHECKs enforce the right field per type.
model Discount {
  id                String         @id @default(uuid(7)) @db.Uuid
  organisationId    String         @db.Uuid
  storeId           String         @db.Uuid
  title             String
  type              DiscountType
  method            DiscountMethod
  status            DiscountStatus @default(ACTIVE)
  percentageBps     Int?
  amount            BigInt?
  currency          String?        @db.Char(3)
  target            DiscountTarget @default(ALL)
  minSubtotalAmount BigInt?
  startsAt          DateTime       @db.Timestamptz(3)
  endsAt            DateTime?      @db.Timestamptz(3)
  usageLimit        Int?
  usageCount        Int            @default(0)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  store       Store                @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  codes       DiscountCode[]
  redemptions DiscountRedemption[]

  @@unique([id, storeId])
  @@index([storeId, status, startsAt])
}

/// SQL: code stored upper-cased; unique per store.
model DiscountCode {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  discountId     String   @db.Uuid
  code           String
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  store       Store                @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  discount    Discount             @relation(fields: [discountId, storeId], references: [id, storeId], onDelete: Cascade)
  redemptions DiscountRedemption[]

  @@unique([storeId, code])
  @@unique([id, storeId])
  @@index([discountId])
}

/// One use of a discount: reserved when a checkout starts paying (the usage
/// count is taken then, under the discount's row lock), redeemed with the
/// order, released when the payment fails or expires (ADR-0031 §7).
model DiscountRedemption {
  id             String           @id @default(uuid(7)) @db.Uuid
  organisationId String           @db.Uuid
  storeId        String           @db.Uuid
  discountId     String           @db.Uuid
  discountCodeId String?          @db.Uuid
  checkoutId     String           @db.Uuid
  orderId        String?          @db.Uuid
  customerId     String?          @db.Uuid
  email          String?
  status         RedemptionStatus @default(RESERVED)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  store        Store         @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  discount     Discount      @relation(fields: [discountId, storeId], references: [id, storeId], onDelete: Restrict)
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  order        Order?        @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([discountId, checkoutId])
  @@unique([discountId, orderId])
  @@index([checkoutId])
  @@index([discountId, customerId])
  @@index([storeId])
  @@index([discountCodeId])
  @@index([orderId])
  @@index([customerId])
}

model ShippingZone {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  store     Store                 @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  countries ShippingZoneCountry[]
  rates     ShippingRate[]

  @@unique([id, storeId])
  @@index([storeId])
}

/// A country (optionally narrowed to regions) belongs to at most one zone per store.
model ShippingZoneCountry {
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  zoneId         String   @db.Uuid
  countryCode    String   @db.Char(2)
  regionCodes    String[]

  store Store        @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  zone  ShippingZone @relation(fields: [zoneId, storeId], references: [id, storeId], onDelete: Cascade)

  @@id([zoneId, countryCode])
  @@unique([storeId, countryCode])
}

model ShippingRate {
  id                String           @id @default(uuid(7)) @db.Uuid
  organisationId    String           @db.Uuid
  storeId           String           @db.Uuid
  zoneId            String           @db.Uuid
  name              String
  type              ShippingRateType
  currency          String           @db.Char(3)
  amount            BigInt
  minSubtotalAmount BigInt?
  maxSubtotalAmount BigInt?
  minWeightGrams    Int?
  maxWeightGrams    Int?
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  store Store        @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  zone  ShippingZone @relation(fields: [zoneId, storeId], references: [id, storeId], onDelete: Cascade)

  @@index([zoneId])
  @@index([storeId])
}

/// One per store. Tax calculation is behind a TaxCalculator interface so an
/// external provider (or India GST CGST/SGST/IGST logic) can plug in.
model TaxConfiguration {
  storeId             String   @id @db.Uuid
  organisationId      String   @db.Uuid
  pricesIncludeTax    Boolean  @default(false)
  chargeTaxOnShipping Boolean  @default(false)
  calculator          String   @default("manual")
  taxRegistrationId   String?
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([storeId, organisationId])
}

/// ratePpm: parts per million (7.25% = 72500). No floating point.
model TaxRate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  countryCode    String   @db.Char(2)
  regionCode     String?
  name           String
  ratePpm        Int
  priority       Int      @default(0)
  compound       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([storeId, countryCode])
}

model Order {
  id               String                @id @default(uuid(7)) @db.Uuid
  organisationId   String                @db.Uuid
  storeId          String                @db.Uuid
  orderNumber      Int
  checkoutId       String?               @unique @db.Uuid
  customerId       String?               @db.Uuid
  email            String?
  phone            String?
  currency         String                @db.Char(3)
  pricesIncludeTax Boolean
  subtotalAmount   BigInt
  discountAmount   BigInt
  shippingAmount   BigInt
  taxAmount        BigInt
  totalAmount      BigInt
  refundedAmount   BigInt                @default(0)
  status           OrderStatus           @default(OPEN)
  paymentStatus    OrderPaymentStatus    @default(PENDING)
  fulfilmentStatus OrderFulfilmentStatus @default(UNFULFILLED)
  /// Paid after its reservation was released and stock ran out (ADR-0031 §4).
  stockShortage    Boolean               @default(false)
  sourceName       String                @default("storefront")
  customerLocale   String?
  note             String?
  tags             String[]
  placedAt         DateTime              @db.Timestamptz(3)
  cancelledAt      DateTime?             @db.Timestamptz(3)
  cancelReason     String?
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  store         Store                @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  addresses     OrderAddress[]
  discounts     OrderDiscount[]
  shippingLines OrderShippingLine[]
  taxLines      OrderTaxLine[]
  events        OrderEvent[]
  payments      Payment[]
  refunds       Refund[]
  fulfilments   Fulfilment[]
  redemptions   DiscountRedemption[]
  notifications OrderNotification[]

  @@unique([storeId, orderNumber])
  @@unique([id, storeId])
  @@index([storeId, placedAt])
  @@index([storeId, status, placedAt])
  @@index([storeId, paymentStatus, fulfilmentStatus])
  @@index([customerId])
}

/// productId/variantId are informational links that survive product purges
/// (SET NULL). All commercial values are snapshots taken at purchase time.
model OrderLine {
  id                String   @id @default(uuid(7)) @db.Uuid
  organisationId    String   @db.Uuid
  storeId           String   @db.Uuid
  orderId           String   @db.Uuid
  productId         String?  @db.Uuid
  variantId         String?  @db.Uuid
  productTitle      String
  variantTitle      String?
  sku               String?
  currency          String   @db.Char(3)
  unitPriceAmount   BigInt
  quantity          Int
  discountAmount    BigInt   @default(0)
  taxAmount         BigInt   @default(0)
  totalAmount       BigInt
  requiresShipping  Boolean
  taxable           Boolean
  weightGrams       Int?
  fulfilledQuantity Int      @default(0)
  refundedQuantity  Int      @default(0)
  attributes        Json?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  store           Store            @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order           Order            @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  fulfilmentLines FulfilmentLine[]
  refundLines     RefundLine[]
  taxLines        OrderTaxLine[]

  @@unique([id, storeId])
  @@index([orderId])
  @@index([variantId])
  @@index([storeId])
  @@index([productId])
}

model OrderAddress {
  id             String      @id @default(uuid(7)) @db.Uuid
  organisationId String      @db.Uuid
  storeId        String      @db.Uuid
  orderId        String      @db.Uuid
  type           AddressType
  firstName      String?
  lastName       String?
  company        String?
  line1          String
  line2          String?
  city           String?
  region         String?
  regionCode     String?
  postalCode     String?
  countryCode    String      @db.Char(2)
  phone          String?

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([orderId, type])
  @@index([storeId])
}

/// Snapshot of each discount applied to the order.
model OrderDiscount {
  id             String       @id @default(uuid(7)) @db.Uuid
  organisationId String       @db.Uuid
  storeId        String       @db.Uuid
  orderId        String       @db.Uuid
  discountId     String?      @db.Uuid
  code           String?
  title          String
  type           DiscountType
  percentageBps  Int?
  amount         BigInt
  currency       String       @db.Char(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([orderId])
  @@index([storeId])
}

model OrderShippingLine {
  id             String  @id @default(uuid(7)) @db.Uuid
  organisationId String  @db.Uuid
  storeId        String  @db.Uuid
  orderId        String  @db.Uuid
  shippingRateId String? @db.Uuid
  title          String
  currency       String  @db.Char(3)
  amount         BigInt
  discountAmount BigInt  @default(0)
  taxAmount      BigInt  @default(0)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([orderId])
  @@index([storeId])
}

model OrderTaxLine {
  id             String  @id @default(uuid(7)) @db.Uuid
  organisationId String  @db.Uuid
  storeId        String  @db.Uuid
  orderId        String  @db.Uuid
  orderLineId    String? @db.Uuid
  title          String
  ratePpm        Int
  currency       String  @db.Char(3)
  amount         BigInt

  store     Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order     Order      @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([storeId])
  @@index([orderLineId])
}

/// Merchant-visible order timeline (append-only).
model OrderEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organisationId String   @db.Uuid
  storeId        String   @db.Uuid
  orderId        String   @db.Uuid
  type           String
  message        String?
  data           Json?
  actorUserId    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([storeId])
}

/// Merchant's link to a payment provider. Secrets are envelope-encrypted
/// (credentialsCiphertext + keyVersion); OAuth account linking preferred.
model PaymentProviderConnection {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  organisationId        String                  @db.Uuid
  storeId               String                  @db.Uuid
  provider              String
  mode                  PaymentProviderMode
  status                PaymentConnectionStatus @default(PENDING)
  externalAccountId     String?
  credentialsCiphertext Bytes?
  keyVersion            Int?
  /// Masked key id for display ("rzp_test_…1234"); never a secret.
  credentialHint        String?
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)

  store    Store     @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  payments Payment[]

  @@unique([storeId, provider, mode])
  @@unique([id, storeId])
}

/// A payment attempt. Created for a checkout before an order exists; linked
/// to the order once the order is created.
model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  organisationId    String        @db.Uuid
  storeId           String        @db.Uuid
  connectionId      String        @db.Uuid
  checkoutId        String?       @db.Uuid
  orderId           String?       @db.Uuid
  provider          String
  /// The provider's handle for this attempt (e.g. a Razorpay payment link).
  providerPaymentId String?
  /// The captured charge (e.g. Razorpay "pay_…"), used for refunds.
  providerChargeId  String?
  /// Hosted payment page the shopper is sent to (repeat submits reuse it).
  redirectUrl       String?
  status            PaymentStatus @default(PENDING)
  currency          String        @db.Char(3)
  amount            BigInt
  capturedAmount    BigInt        @default(0)
  refundedAmount    BigInt        @default(0)
  idempotencyKey    String        @unique
  failureCode       String?
  failureMessage    String?
  expiresAt         DateTime      @db.Timestamptz(3)
  capturedAt        DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  store      Store                     @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  connection PaymentProviderConnection @relation(fields: [connectionId, storeId], references: [id, storeId], onDelete: Restrict)
  checkout   Checkout?                 @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  order      Order?                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds    Refund[]

  @@unique([provider, providerPaymentId])
  @@unique([id, storeId])
  @@index([orderId])
  @@index([checkoutId])
  @@index([storeId])
  @@index([connectionId])
}

/// Idempotency ledger for merchant payment-provider webhooks, per store: one
/// merchant can't pre-empt another store's event ids (ADR-0031 §4).
model PaymentWebhookEvent {
  id              String               @id @default(uuid(7)) @db.Uuid
  organisationId  String               @db.Uuid
  storeId         String               @db.Uuid
  provider        String
  providerEventId String
  type            String
  status          InboundWebhookStatus @default(RECEIVED)
  attempts        Int                  @default(0)
  lastError       String?
  payload         Json
  receivedAt      DateTime             @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?            @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([storeId, provider, providerEventId])
  @@index([status, receivedAt])
  @@index([storeId])
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  organisationId   String       @db.Uuid
  storeId          String       @db.Uuid
  orderId          String       @db.Uuid
  paymentId        String       @db.Uuid
  status           RefundStatus @default(PENDING)
  currency         String       @db.Char(3)
  amount           BigInt
  reason           String?
  providerRefundId String?
  failureMessage   String?
  idempotencyKey   String       @unique
  createdById      String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  store   Store        @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order   Order        @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)
  payment Payment      @relation(fields: [paymentId, storeId], references: [id, storeId], onDelete: Restrict)
  lines   RefundLine[]

  @@unique([id, storeId])
  @@index([orderId])
  @@index([storeId])
  @@index([paymentId])
}

model RefundLine {
  id                String  @id @default(uuid(7)) @db.Uuid
  organisationId    String  @db.Uuid
  storeId           String  @db.Uuid
  refundId          String  @db.Uuid
  orderLineId       String  @db.Uuid
  quantity          Int
  amount            BigInt
  restockLocationId String? @db.Uuid

  store     Store     @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  refund    Refund    @relation(fields: [refundId, storeId], references: [id, storeId], onDelete: Restrict)
  orderLine OrderLine @relation(fields: [orderLineId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([refundId, orderLineId])
  @@index([storeId])
  @@index([orderLineId])
}

model Fulfilment {
  id              String          @id @default(uuid(7)) @db.Uuid
  organisationId  String          @db.Uuid
  storeId         String          @db.Uuid
  orderId         String          @db.Uuid
  locationId      String          @db.Uuid
  state           FulfilmentState @default(PENDING)
  trackingCompany String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?       @db.Timestamptz(3)
  createdById     String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  store    Store            @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order    Order            @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)
  location Location         @relation(fields: [locationId, storeId], references: [id, storeId], onDelete: Restrict)
  lines    FulfilmentLine[]

  @@unique([id, storeId])
  @@index([orderId])
  @@index([storeId])
  @@index([locationId])
}

model FulfilmentLine {
  id             String @id @default(uuid(7)) @db.Uuid
  organisationId String @db.Uuid
  storeId        String @db.Uuid
  fulfilmentId   String @db.Uuid
  orderLineId    String @db.Uuid
  quantity       Int

  store      Store      @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  fulfilment Fulfilment @relation(fields: [fulfilmentId, storeId], references: [id, storeId], onDelete: Cascade)
  orderLine  OrderLine  @relation(fields: [orderLineId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([fulfilmentId, orderLineId])
  @@index([storeId])
  @@index([orderLineId])
}

/// Shopper emails, queued in the transaction that changes the order and sent
/// by the worker with retries (ADR-0031 §12). An email failure never rolls
/// back an order. dedupeKey makes each announcement exactly one row.
model OrderNotification {
  id             String             @id @default(uuid(7)) @db.Uuid
  organisationId String             @db.Uuid
  storeId        String             @db.Uuid
  orderId        String             @db.Uuid
  kind           NotificationKind
  dedupeKey      String             @unique
  recipient      String
  referenceId    String?            @db.Uuid
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now()) @db.Timestamptz(3)
  lastError      String?
  sentAt         DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  store Store @relation(fields: [storeId, organisationId], references: [id, organisationId], onDelete: Restrict)
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@index([storeId])
}
