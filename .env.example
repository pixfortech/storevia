# Storevia environment variables: EXAMPLE VALUES ONLY.
# Copy to `.env` for local development. Never commit real secrets.
# Each app validates its own variables at start-up (see docs/architecture/02-monorepo.md §5).
# Variables are introduced by the milestone noted beside them.

# --- Runtime -----------------------------------------------------------------
STOREVIA_ENV=development                     # development | test | preview | staging | production
LOG_LEVEL=info

# --- Database (M1) -----------------------------------------------------------
# Superuser used only by `pnpm db:setup` / `pnpm db:reset` (local and CI).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Application role (NOBYPASSRLS). Local docker compose defaults.
DATABASE_URL=postgresql://storevia_app:storevia_app@localhost:5432/storevia
# Schema owner (BYPASSRLS): migrations and reference seeds only (`pnpm db:migrate`,
# `pnpm db:seed`, CI/CD migration job). Never used by running apps.
DATABASE_MIGRATOR_URL=postgresql://storevia_migrator:storevia_migrator@localhost:5432/storevia
# System role (BYPASSRLS, narrow grants) for the allow-listed @storevia/database/system
# entry point: auth identity tables, invitation-token lookup; later hostname
# resolution, inbound webhook ledgers and schedulers (docs/architecture/03-tenancy.md §5.3).
DATABASE_SYSTEM_URL=postgresql://storevia_system:storevia_system@localhost:5432/storevia
# Platform-admin role (BYPASSRLS, reads plus the audited writes staff actions need).
DATABASE_PLATFORM_URL=postgresql://storevia_platform:storevia_platform@localhost:5432/storevia
# Billing role (BYPASSRLS, narrow): webhook pipeline, mock provider, expiry sweep (M2).
# Only processes that ingest provider events or run the sweep need it.
DATABASE_BILLING_URL=postgresql://storevia_billing:storevia_billing@localhost:5432/storevia
# Worker role (BYPASSRLS, narrow): job scheduler tables and usage reconciliation (M2.5).
DATABASE_WORKER_URL=postgresql://storevia_worker:storevia_worker@localhost:5432/storevia
# Marketing-site role (NOBYPASSRLS): reads the public plan catalogue and its own
# rate-limit rows only (ADR-0025). The only database access apps/marketing has.
DATABASE_MARKETING_URL=postgresql://storevia_marketing:storevia_marketing@localhost:5432/storevia
# Storefront role (NOBYPASSRLS): resolves hosts through one narrow function and
# reads only sellable rows of the resolved store; writes carts (ADR-0028 §2).
DATABASE_STOREFRONT_URL=postgresql://storevia_storefront:storevia_storefront@localhost:5432/storevia

# --- Edge (M1) -----------------------------------------------------------------
# Header set by the edge/proxy that carries the real client IP (right-most entry
# is used). Required in staging and production; leave empty locally.
TRUSTED_CLIENT_IP_HEADER=

# --- Public URLs (M1) ---------------------------------------------------------
MARKETING_URL=http://localhost:3000
DASHBOARD_URL=http://app.localhost:3001
PLATFORM_ADMIN_URL=http://admin.localhost:3003
# Where marketing contact-form messages are delivered (M2.5).
CONTACT_INBOX=hello@storevia.test
STOREFRONT_ROOT_DOMAIN=store.localhost:3002       # production: storevia.site
# Storefront (M4, ADR-0028). http only for local development.
STOREFRONT_PROTOCOL=http                          # production: https
# Where the worker posts cache invalidations (the storefront's own origin).
STOREFRONT_INTERNAL_URL=http://localhost:3002
# 32+ random characters each. Generate with: openssl rand -base64 32
# The preview secret is shared with the dashboard (it issues preview links);
# the revalidate secret with the worker (it posts cache invalidations).
STOREFRONT_PREVIEW_SECRET=replace-me-with-32-random-characters
STOREFRONT_REVALIDATE_SECRET=replace-me-with-32-random-characters

# --- Authentication (M1) ------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_PLATFORM_SECRET=replace-me
# Optional Google sign-in (disabled when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (M1) ---------------------------------------------------------------
# Local: Mailpit from docker compose (UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Storevia <no-reply@storevia.localhost>"

# --- Encryption (M2+) ---------------------------------------------------------
# Local development only. Production uses KMS (envelope encryption).
LOCAL_ENCRYPTION_KEY=replace-me

# --- SaaS billing (M2, ADR-0022) ---------------------------------------------
# No real payment gateway is integrated yet. Mock billing (a signed, simulated
# provider) is enabled by the dev server in development and test. Production
# builds (`next start`, local E2E) and staging need BILLING_MOCK_ENABLED=true.
# It can never be enabled in preview or production.
# 32+ random characters. Generate with: openssl rand -hex 32
MOCK_BILLING_WEBHOOK_SECRET=replace-me
BILLING_MOCK_ENABLED=true           # set false/remove outside local development

# --- Object storage (M3, ADR-0027 §9) -----------------------------------------
# local (default in development and test, and only allowed there): files under
# MEDIA_LOCAL_DIR, uploaded to and served by the dashboard. s3: any S3-compatible
# service with browser POST uploads (S3, MinIO). Raw uploads go under the
# uploads/ prefix: never serve it, and expire it with a bucket lifecycle rule.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.media                     # relative to the dashboard's working directory
# Signs local upload tokens. Optional locally (derived from AUTH_SECRET when empty).
MEDIA_UPLOAD_SECRET=
# S3 settings (MEDIA_STORAGE=s3). MinIO shown; path-style unless set to false.
S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=storevia-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/storevia-media
