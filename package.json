{
  "name": "storevia",
  "private": true,
  "description": "Storevia: multi-tenant commerce and website-building platform",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @storevia/dashboard test:e2e",
    "test:tooling": "node --test \"scripts/*.test.mjs\"",
    "toolchain:check": "node scripts/toolchain-check.mjs",
    "db:setup": "pnpm --filter @storevia/database db:setup",
    "db:migrate": "pnpm --filter @storevia/database db:migrate",
    "db:migrate:dev": "pnpm --filter @storevia/database db:migrate:dev",
    "db:reset": "pnpm --filter @storevia/database db:reset",
    "db:seed": "pnpm --filter @storevia/database db:seed",
    "db:test:prepare": "pnpm --filter @storevia/database db:test:prepare",
    "db:validate:draft": "prisma validate --schema docs/database/schema.draft.prisma && node scripts/check-fk-indexes.mjs docs/database/schema.draft.prisma",
    "check:schema": "node scripts/check-schema-agreement.mjs packages/database/prisma/schema.prisma docs/database/schema.draft.prisma && node scripts/check-fk-indexes.mjs packages/database/prisma/schema.prisma",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm db:validate:draft && pnpm check:schema",
    "postinstall": "pnpm --filter @storevia/database generate",
    "db:seed:dev": "pnpm --filter @storevia/dashboard seed:dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "turbo": "2.11.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  }
}
